{
  "name": "resume-grill-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "node scripts/build/index.mjs",
    "start": "node dist/adapters/cli/main.js serve",
    "pretest": "npm run build",
    "test": "tsx --test \"tests/**/*.test.ts\"",
    "check": "tsc --noEmit",
    "demo": "tsx examples/demo.ts",
    "panel": "node dist/adapters/cli/main.js panel",
    "prepanel": "npm run build",
    "package:plugin": "npm run build && node scripts/release/package.mjs",
    "verify:panel": "node scripts/verify/panel.mjs",
    "verify:dsh": "node scripts/verify/dsh-native.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@napi-rs/canvas": "1.0.3",
    "@pdf-lib/fontkit": "1.1.1",
    "cheerio": "1.2.0",
    "fonteditor-core": "2.6.3",
    "ipaddr.js": "2.5.0",
    "mammoth": "1.12.0",
    "nodemailer": "10.5.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.2.108",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "playwright-core": "1.65.0",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2"
  },
  "main": "./dist/adapters/dsh/host.js",
  "exports": {
    ".": "./dist/adapters/dsh/host.js",
    "./client": "./dist/adapters/dsh/client.js",
    "./locale/*.json": "./plugin/locale/*.json",
    "./icon": "./plugin/icon.svg",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./plugin/cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  },
  "files": [
    "dist",
    "assets",
    "plugin",
    "skills",
    "docs",
    "examples/dsh-mcp.patch.yml",
    "LICENSE",
    "THIRD_PARTY.md",
    "README.md"
  ],
  "description": "在 DSH 对话中读取岗位、核对简历并确认邮箱投递。"
}
