{
  "name": "resume-grill-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc && node scripts/build-panel.mjs && node scripts/build-dsh.mjs",
    "start": "node dist/cli.js serve",
    "pretest": "npm run build",
    "test": "tsx --test test/*.test.ts",
    "check": "tsc --noEmit",
    "demo": "tsx examples/demo.ts",
    "panel": "node dist/cli.js panel",
    "prepanel": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@napi-rs/canvas": "1.0.3",
    "@pdf-lib/fontkit": "1.1.1",
    "cheerio": "1.2.0",
    "fonteditor-core": "2.6.3",
    "ipaddr.js": "2.5.0",
    "mammoth": "1.12.0",
    "nodemailer": "10.5.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.2.108",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "playwright-core": "1.65.0",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2"
  },
  "main": "./dist/dsh/host.js",
  "exports": {
    ".": "./dist/dsh/host.js",
    "./client": "./dist/dsh/client.js",
    "./locale/*.json": "./integrations/dsh/locale/*.json",
    "./icon": "./integrations/dsh/icon.svg",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./integrations/dsh/cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  },
  "files": [
    "dist",
    "assets",
    "integrations/dsh",
    "skills",
    "LICENSE",
    "THIRD_PARTY.md",
    "README.md"
  ]
}
